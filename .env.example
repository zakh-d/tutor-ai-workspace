# Copy to .env and replace every password before deployment (URL-safe values).
APP_HOST=app.localhost
AUTH_HOST=auth.localhost
PUBLIC_BASE_URL=https://app.localhost
KEYCLOAK_URL=https://auth.localhost
KEYCLOAK_ISSUER=https://auth.localhost/realms/tutor
MCP_AUDIENCE=https://app.localhost/mcp
POSTGRES_PASSWORD=replace-postgres-password
APP_DB_PASSWORD=replace-runtime-password
MIGRATION_DB_PASSWORD=replace-migration-password
KEYCLOAK_DB_PASSWORD=replace-keycloak-db-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-keycloak-admin-password
S3_ACCESS_KEY=tutor-app
S3_SECRET_KEY=replace-minio-password
S3_BUCKET=tutor-materials
# Fernet key generated with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
